---
import '../styles/support-section.css';
import { useLocale } from '../i18n';
import Icon from './icons/Icon.astro';
import { SUPPORT_CHANNELS } from '../config/outbound-redirects.mjs';
import { Button } from '@/components/starwind/button';
import {
  Card,
  CardContent,
  CardFooter,
  CardHeader,
} from '@/components/starwind/card';

interface Props {
  titleId?: string;
  showTicketTips?: boolean;
  class?: string;
}

const { titleId = 'support-title', showTicketTips = false, class: className } = Astro.props;
const { t } = useLocale(Astro.currentLocale);
const c = t.support;
const channelIcons = { tickets: 'headphones', documentation: 'navBlog', faq: 'navFaq' } as const;
---

<section
  id="support"
  class:list={['support-section border-y border-border bg-muted/20 py-10 md:py-14', className]}
  aria-labelledby={titleId}
>
  <div class="support-section__inner mx-auto max-w-6xl px-5">
    <header class="section-header section-header--wide support-section__header">
      <p class="section-header__eyebrow">{c.eyebrow}</p>
      <h1 id={titleId} class="section-header__title text-foreground">{c.title}</h1>
      <p class="section-header__subtitle">{c.subtitle}</p>
    </header>

    <ul class="support-section__cards">
      {
        c.channels.map((channel) => (
          <li>
            <Card class="h-full transition-shadow hover:shadow-md">
              <CardHeader class="gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-primary/10">
                  <Icon name={channelIcons[channel.id]} size={22} class="support-section__icon" />
                </div>
                <h2 class="text-lg font-semibold leading-snug">{channel.title}</h2>
              </CardHeader>
              <CardContent>
                <p class="text-sm leading-relaxed text-muted-foreground">{channel.desc}</p>
              </CardContent>
              <CardFooter class="mt-auto">
                <Button
                  as="a"
                  href={SUPPORT_CHANNELS[channel.id].path}
                  variant={channel.id === 'tickets' ? 'primary' : 'outline'}
                  size="md"
                  class="min-h-12 w-full"
                >
                  {channel.linkLabel}
                  <Icon name="arrowUpRight" size={17} />
                </Button>
              </CardFooter>
            </Card>
          </li>
        ))
      }
    </ul>

    {
      showTicketTips && (
        <div class="support-section__tips">
          <h2 class="support-section__tips-title">{c.ticketTitle}</h2>
          <ul class="support-section__tips-list">
            {c.ticketItems.map((item) => (
              <li class="rounded-xl border border-border bg-card p-4">
                <p class="support-section__tips-item-title">{item.title}</p>
                <p class="support-section__tips-item-desc">{item.desc}</p>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>
