{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/optimize-images.mjs && node scripts/generate-static-redirects.mjs && astro build && node scripts/prune-dist-images.mjs && node scripts/finalize-sitemap.mjs",
    "indexnow:submit": "npm run validate && node scripts/indexnow.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:runtime": "npm run validate && node scripts/runtime-smoke.mjs",
    "smoke:runtime": "node scripts/runtime-smoke.mjs",
    "validate:browser": "npm run validate && node scripts/browser-smoke.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "validate:lighthouse": "npm run validate && node scripts/lighthouse-smoke.mjs",
    "smoke:lighthouse": "node scripts/lighthouse-smoke.mjs",
    "validate:cloudflare": "npm run validate && node scripts/cloudflare-smoke.mjs",
    "smoke:cloudflare": "node scripts/cloudflare-smoke.mjs",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "astro check",
    "preview": "astro preview --host 0.0.0.0",
    "start": "node scripts/serve.mjs",
    "astro": "astro",
    "optimize:images": "node scripts/optimize-images.mjs",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "validate:links": "npm run validate",
    "validate:pages": "npm run validate && node scripts/pages-smoke.mjs",
    "smoke:pages": "node scripts/pages-smoke.mjs",
    "check:conversion": "node scripts/check-conversion.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check:quick": "node scripts/quick-check.mjs",
    "visual:baseline": "node scripts/visual-qa.mjs baseline",
    "visual:check": "node scripts/visual-qa.mjs check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/outfit": "^5.3.0",
    "@lucide/astro": "^1.48.0",
    "@starwind-ui/astro": "^1.2.1",
    "@tabler/icons": "^3.48.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.3.3",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "lighthouse": "12.8.2",
    "parse5": "^7.3.0",
    "playwright-core": "1.64.1",
    "typescript": "^5.9.2",
    "wrangler": "4.156.0"
  }
}
